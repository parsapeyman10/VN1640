  if (gBehaviourLost[5]) LS_ICN_SPD_GWY = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[5]) Ls_Icn_Speed_Display = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[9]) Hs_Peps_VehSpd = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[11]) Hs_Tcu_EngBrkTorqReductValue = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[11]) Hs_Tcu_N_EngBrkTorqLimitValue = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[11]) Hs_Tcu_EngBrkTorqIncreValue = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[11]) Hs_Tcu_TorqConvTurbineSpeed = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[11]) Hs_Tcu_DesiredEngIdlSpdReq = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[11]) Hs_Tcu_IdleControlLoadTorque = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[11]) Hs_Tcu_MaxEngSpeedLimReq = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[11]) Hs_Tcu_OutputShaftSpeed = 0;   /* speed -> 0 when the sender is gone */

  /* ---- cascade: a node that needs what is missing reports its own loss ---- */
  /* ABS needs ABS */
  if (gBehaviourLost[0]) Hs_Abs_Com_Loss = 1;
  if (gBehaviourLost[0]) Hs_Abs_VehicleSpeed_Invalid = 1;
  /* ICU needs ABS */
  if (gBehaviourLost[0]) Hs_Icu_Com_Loss = 1;
  /* TCU needs EMS */
  if (gBehaviourLost[2]) Hs_Tcu_Com_Loss = 1;
  /* ICU needs EMS */
  if (gBehaviourLost[2]) Hs_Icu_Com_Loss = 1;
  /* ICN needs EMS */
  /* ICN needs ABS */
}

