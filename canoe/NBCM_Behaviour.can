/*----------------------------------------------------------------------------
  1) freshness: the restbus calls this for every frame it sends.
----------------------------------------------------------------------------*/
void BehaviourMarkSent(char nodeName[], char msgName[])
{
  int i;
  for (i = 0; i < 88; i++)
  {
    if (strncmp(gBehaviourFrameNode[i], nodeName, 16) == 0 &&
        strncmp(gBehaviourFrameMsg[i], msgName, 32) == 0)
    {
      gBehaviourLastSeen[i] = 0;   /* 0 = seen in this tick */
      return;
    }
  }
}

/*----------------------------------------------------------------------------
  2) one tick, called every 100 ms from on timer
----------------------------------------------------------------------------*/
void BehaviourTick()
{
  int i;
  int lost;
  int frames_of_node;
  /* ---- absence ---- */
  /* ABS */
  gBehaviourLastSeen[0]++, gBehaviourLastSeen[1]++, gBehaviourLastSeen[2]++, gBehaviourLastSeen[3]++, gBehaviourLastSeen[4]++, gBehaviourLastSeen[5]++;
  lost = (gBehaviourLastSeen[0] > 0 && gBehaviourLastSeen[1] > 0 && gBehaviourLastSeen[2] > 0 && gBehaviourLastSeen[3] > 0 && gBehaviourLastSeen[4] > 0 && gBehaviourLastSeen[5] > 0) ? 1 : 0;
  if (OFFLINE_ABS) lost = 1;
  gBehaviourLost[0] = lost;
  /* DIAG */
  gBehaviourLastSeen[6]++, gBehaviourLastSeen[7]++, gBehaviourLastSeen[8]++, gBehaviourLastSeen[9]++, gBehaviourLastSeen[10]++, gBehaviourLastSeen[11]++, gBehaviourLastSeen[12]++, gBehaviourLastSeen[13]++, gBehaviourLastSeen[14]++, gBehaviourLastSeen[15]++;
