  /* EMS */
  gBehaviourLastSeen[16]++, gBehaviourLastSeen[17]++, gBehaviourLastSeen[18]++, gBehaviourLastSeen[19]++, gBehaviourLastSeen[20]++, gBehaviourLastSeen[21]++, gBehaviourLastSeen[22]++, gBehaviourLastSeen[23]++, gBehaviourLastSeen[24]++, gBehaviourLastSeen[25]++, gBehaviourLastSeen[26]++, gBehaviourLastSeen[27]++, gBehaviourLastSeen[28]++, gBehaviourLastSeen[29]++, gBehaviourLastSeen[30]++;
  lost = (gBehaviourLastSeen[16] > 0 && gBehaviourLastSeen[17] > 0 && gBehaviourLastSeen[18] > 0 && gBehaviourLastSeen[19] > 0 && gBehaviourLastSeen[20] > 0 && gBehaviourLastSeen[21] > 0 && gBehaviourLastSeen[22] > 0 && gBehaviourLastSeen[23] > 0 && gBehaviourLastSeen[24] > 0 && gBehaviourLastSeen[25] > 0 && gBehaviourLastSeen[26] > 0 && gBehaviourLastSeen[27] > 0 && gBehaviourLastSeen[28] > 0 && gBehaviourLastSeen[29] > 0 && gBehaviourLastSeen[30] > 0) ? 1 : 0;
  if (OFFLINE_EMS) lost = 1;
  gBehaviourLost[2] = lost;
  /* EPS */
