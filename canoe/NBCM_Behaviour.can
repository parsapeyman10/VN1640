  if (OFFLINE_RBG) lost = 1;
  gBehaviourLost[10] = lost;
  /* TCU */
  gBehaviourLastSeen[82]++, gBehaviourLastSeen[83]++, gBehaviourLastSeen[84]++, gBehaviourLastSeen[85]++;
  lost = (gBehaviourLastSeen[82] > 0 && gBehaviourLastSeen[83] > 0 && gBehaviourLastSeen[84] > 0 && gBehaviourLastSeen[85] > 0) ? 1 : 0;
  if (OFFLINE_TCU) lost = 1;
  gBehaviourLost[11] = lost;
  /* TPMS */
  gBehaviourLastSeen[86]++, gBehaviourLastSeen[87]++;
  lost = (gBehaviourLastSeen[86] > 0 && gBehaviourLastSeen[87] > 0) ? 1 : 0;
  if (OFFLINE_TPMS) lost = 1;
  gBehaviourLost[12] = lost;

  /* ---- report: Com_Loss and its counter, for every node with a SUP frame ---- */
  Hs_Abs_Com_Loss = gBehaviourLost[0];
  if (gBehaviourLost[0]) { if (Hs_Abs_Com_Loss_Counter < 255) Hs_Abs_Com_Loss_Counter++; }
  else Hs_Abs_Com_Loss_Counter = 0;
  Hs_Ems_Com_Loss = gBehaviourLost[2];
  if (gBehaviourLost[2]) { if (Hs_Ems_Com_Loss_Counter < 255) Hs_Ems_Com_Loss_Counter++; }
  else Hs_Ems_Com_Loss_Counter = 0;
  Hs_Eps_COM_Loss = gBehaviourLost[3];
  if (gBehaviourLost[3]) { if (Hs_Eps_Com_Loss_Counter < 255) Hs_Eps_Com_Loss_Counter++; }
  else Hs_Eps_Com_Loss_Counter = 0;
  Hs_Icu_Com_Loss = gBehaviourLost[6];
  if (gBehaviourLost[6]) { if (Hs_Icu_Com_Loss_Counter < 255) Hs_Icu_Com_Loss_Counter++; }
  else Hs_Icu_Com_Loss_Counter = 0;
  Hs_Tcu_Com_Loss = gBehaviourLost[11];
  if (gBehaviourLost[11]) { if (Hs_Tcu_Com_Loss_Counter < 255) Hs_Tcu_Com_Loss_Counter++; }
  else Hs_Tcu_Com_Loss_Counter = 0;
  Hs_Tpms_COM_Loss = gBehaviourLost[12];
  if (gBehaviourLost[12]) { if (Hs_Tpms_Com_Loss_Counter < 255) Hs_Tpms_Com_Loss_Counter++; }
  else Hs_Tpms_Com_Loss_Counter = 0;

  /* ---- substitute: missing data is replaced, never frozen ---- */
  if (gBehaviourLost[0]) Hs_Abs_Wheel_Speed_Fl = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[0]) Hs_Abs_Wheel_Speed_Fr = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[0]) Hs_Abs_Wheel_Speed_Rl = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[0]) Hs_Abs_Wheel_Speed_Rr = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[0]) Hs_Esc_TorqueReductValue = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[0]) Hs_Abs_VehicleSpeed = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[2]) Hs_Ems_EngineActualTorque = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[2]) Hs_Ems_EngineFrictionTorque = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[2]) Hs_Ems_IndicatedEngineTorque1 = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[2]) Hs_Ems_MaxBrkTorq = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[2]) Hs_Ems_DriverReqTorq = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[2]) Hs_Ems_EngBrkTorqwithoutTCU = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[2]) Hs_Ems_EngineIdleTargetSpeed = 0;   /* speed -> 0 when the sender is gone */
  if (gBehaviourLost[2]) Hs_Ems_MinlndicatedTorq = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[2]) Hs_Ems_Rpm = 0;   /* rpm -> 0, engine seen as stopped */
  if (gBehaviourLost[2]) Hs_Ems_BrakeEngineTorque2 = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[2]) Hs_Ems_BrakeTorqueConstant = 0;   /* torque -> 0, no pedal input */
  if (gBehaviourLost[2]) Hs_Ems_FrictionalTorq = 0;   /* torque -> 0, no pedal input */
