  if (OFFLINE_EPS) lost = 1;
  gBehaviourLost[3] = lost;
  /* HVAC */
  gBehaviourLastSeen[34]++, gBehaviourLastSeen[35]++, gBehaviourLastSeen[36]++, gBehaviourLastSeen[37]++;
  lost = (gBehaviourLastSeen[34] > 0 && gBehaviourLastSeen[35] > 0 && gBehaviourLastSeen[36] > 0 && gBehaviourLastSeen[37] > 0) ? 1 : 0;
  if (OFFLINE_HVAC) lost = 1;
  gBehaviourLost[4] = lost;
  /* ICN */
  gBehaviourLastSeen[38]++, gBehaviourLastSeen[39]++, gBehaviourLastSeen[40]++, gBehaviourLastSeen[41]++, gBehaviourLastSeen[42]++, gBehaviourLastSeen[43]++, gBehaviourLastSeen[44]++, gBehaviourLastSeen[45]++, gBehaviourLastSeen[46]++, gBehaviourLastSeen[47]++, gBehaviourLastSeen[48]++, gBehaviourLastSeen[49]++, gBehaviourLastSeen[50]++, gBehaviourLastSeen[51]++, gBehaviourLastSeen[52]++, gBehaviourLastSeen[53]++, gBehaviourLastSeen[54]++, gBehaviourLastSeen[55]++, gBehaviourLastSeen[56]++, gBehaviourLastSeen[57]++, gBehaviourLastSeen[58]++;
  lost = (gBehaviourLastSeen[38] > 0 && gBehaviourLastSeen[39] > 0 && gBehaviourLastSeen[40] > 0 && gBehaviourLastSeen[41] > 0 && gBehaviourLastSeen[42] > 0 && gBehaviourLastSeen[43] > 0 && gBehaviourLastSeen[44] > 0 && gBehaviourLastSeen[45] > 0 && gBehaviourLastSeen[46] > 0 && gBehaviourLastSeen[47] > 0 && gBehaviourLastSeen[48] > 0 && gBehaviourLastSeen[49] > 0 && gBehaviourLastSeen[50] > 0 && gBehaviourLastSeen[51] > 0 && gBehaviourLastSeen[52] > 0 && gBehaviourLastSeen[53] > 0 && gBehaviourLastSeen[54] > 0 && gBehaviourLastSeen[55] > 0 && gBehaviourLastSeen[56] > 0 && gBehaviourLastSeen[57] > 0 && gBehaviourLastSeen[58] > 0) ? 1 : 0;
  if (OFFLINE_ICN) lost = 1;
  gBehaviourLost[5] = lost;
  /* ICU */
  gBehaviourLastSeen[59]++, gBehaviourLastSeen[60]++, gBehaviourLastSeen[61]++, gBehaviourLastSeen[62]++, gBehaviourLastSeen[63]++, gBehaviourLastSeen[64]++, gBehaviourLastSeen[65]++, gBehaviourLastSeen[66]++;
  lost = (gBehaviourLastSeen[59] > 0 && gBehaviourLastSeen[60] > 0 && gBehaviourLastSeen[61] > 0 && gBehaviourLastSeen[62] > 0 && gBehaviourLastSeen[63] > 0 && gBehaviourLastSeen[64] > 0 && gBehaviourLastSeen[65] > 0 && gBehaviourLastSeen[66] > 0) ? 1 : 0;
  if (OFFLINE_ICU) lost = 1;
  gBehaviourLost[6] = lost;
  /* ITPMS */
  gBehaviourLastSeen[67]++;
  lost = (gBehaviourLastSeen[67] > 0) ? 1 : 0;
  if (OFFLINE_ITPMS) lost = 1;
  gBehaviourLost[7] = lost;
  /* MMS */
  gBehaviourLastSeen[68]++, gBehaviourLastSeen[69]++, gBehaviourLastSeen[70]++, gBehaviourLastSeen[71]++, gBehaviourLastSeen[72]++, gBehaviourLastSeen[73]++, gBehaviourLastSeen[74]++;
  lost = (gBehaviourLastSeen[68] > 0 && gBehaviourLastSeen[69] > 0 && gBehaviourLastSeen[70] > 0 && gBehaviourLastSeen[71] > 0 && gBehaviourLastSeen[72] > 0 && gBehaviourLastSeen[73] > 0 && gBehaviourLastSeen[74] > 0) ? 1 : 0;
  if (OFFLINE_MMS) lost = 1;
  gBehaviourLost[8] = lost;
  /* PEPS */
  gBehaviourLastSeen[75]++, gBehaviourLastSeen[76]++;
  lost = (gBehaviourLastSeen[75] > 0 && gBehaviourLastSeen[76] > 0) ? 1 : 0;
  if (OFFLINE_PEPS) lost = 1;
  gBehaviourLost[9] = lost;
  /* RBG */
