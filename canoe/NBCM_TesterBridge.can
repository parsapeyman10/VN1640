  publishHealth();

  gTick++;
  @sysvar::NBCM_Test::HB_BRIDGE = 0;   // reserved
}

/*----------------------------------------------------------------------------
  Turn the last-seen timestamps into the two numbers the panel binds to:
      HB_<NODE>   1 while the node talked within the last 500 ms
      AGE_<NODE>  age in milliseconds (0 when it was never seen)
----------------------------------------------------------------------------*/
void publishHealth()
{
  dword now = timeNow();

  publishNode(now, gLastSeen_ABS, &@sysvar::NBCM_Test::HB_ABS, &@sysvar::NBCM_Test::AGE_ABS);
  publishNode(now, gLastSeen_DIAG, &@sysvar::NBCM_Test::HB_DIAG, &@sysvar::NBCM_Test::AGE_DIAG);
  publishNode(now, gLastSeen_EMS, &@sysvar::NBCM_Test::HB_EMS, &@sysvar::NBCM_Test::AGE_EMS);
  publishNode(now, gLastSeen_EPS, &@sysvar::NBCM_Test::HB_EPS, &@sysvar::NBCM_Test::AGE_EPS);
  publishNode(now, gLastSeen_HVAC, &@sysvar::NBCM_Test::HB_HVAC, &@sysvar::NBCM_Test::AGE_HVAC);
  publishNode(now, gLastSeen_ICN, &@sysvar::NBCM_Test::HB_ICN, &@sysvar::NBCM_Test::AGE_ICN);
  publishNode(now, gLastSeen_ICU, &@sysvar::NBCM_Test::HB_ICU, &@sysvar::NBCM_Test::AGE_ICU);
  publishNode(now, gLastSeen_ITPMS, &@sysvar::NBCM_Test::HB_ITPMS, &@sysvar::NBCM_Test::AGE_ITPMS);
  publishNode(now, gLastSeen_MMS, &@sysvar::NBCM_Test::HB_MMS, &@sysvar::NBCM_Test::AGE_MMS);
  publishNode(now, gLastSeen_PEPS, &@sysvar::NBCM_Test::HB_PEPS, &@sysvar::NBCM_Test::AGE_PEPS);
  publishNode(now, gLastSeen_RBG, &@sysvar::NBCM_Test::HB_RBG, &@sysvar::NBCM_Test::AGE_RBG);
  publishNode(now, gLastSeen_TCU, &@sysvar::NBCM_Test::HB_TCU, &@sysvar::NBCM_Test::AGE_TCU);
  publishNode(now, gLastSeen_TPMS, &@sysvar::NBCM_Test::HB_TPMS, &@sysvar::NBCM_Test::AGE_TPMS);
}

void publishNode(dword now, dword lastSeen, long *hb, long *age)
{
  long delta;

  if (lastSeen == 0)
  {
    *hb  = 0;
    *age = 0;
    return;
  }
  delta = (long)(now - lastSeen);
  *age = delta;
  *hb  = (delta < 500) ? 1 : 0;
}

/*----------------------------------------------------------------------------
  Convenience handlerse -- allow simple keyboard checks from CANoe itself.
----------------------------------------------------------------------------*/
on key 't'
{
  @sysvar::NBCM_Test::DRIVE_MODE = (@sysvar::NBCM_Test::DRIVE_MODE == 1) ? 0 : 1;
  write("[TesterBridge] DRIVE_MODE toggled");
}
