/*@!Encoding:65001*/
/*============================================================================
  NBCM_TesterBridge.can -- CANoe 12 bridge between the HTML tester and the
  restbus simulation in NBCM_Full_Restbus_Simulation.can

  GENERATED by tools/build_capl.py on 2026-11-21 12:11 UTC
  Do not edit by hand -- change the workbook and regenerate.

  HOW TO USE
  1) Add canoe/NBCM_Test.vsysvar to the CANoe configuration
     (System Variables window -> Import / add as file).
  2) Add this file to the SAME network node as the restbus simulation
     (or as an include in it) so it can see the CAPL variables.
  3) Measurement start: values flow restbus -> system variables.
  4) The HTML tester (or COM, or CAPL) sets NBCM_Test::DRIVE_MODE=1 to take
     control; then system variables -> restbus each 100 ms.

  SIGNAL CONTRACT
    NBCM_Test::<SignalName>      = value of that signal
    NBCM_Test::OFFLINE_<NODE>    = 1 -> node stops transmitting
    NBCM_Test::DRIVE_MODE        = 0 observe / 1 control
============================================================================*/

variables
{
  msTimer tmrTesterBridge;
  long  gLastDriveMode = 0;
  long  gTick = 0;

  // last time each node was heard on the bus, for the panel health LEDs.
  // 0 means nothing seen yet: the panel shows age 0 and a grey LED.
  dword gLastSeen_ABS;
  dword gLastSeen_DIAG;
  dword gLastSeen_EMS;
  dword gLastSeen_EPS;
  dword gLastSeen_HVAC;
  dword gLastSeen_ICN;
  dword gLastSeen_ICU;
  dword gLastSeen_ITPMS;
  dword gLastSeen_MMS;
  dword gLastSeen_PEPS;
  dword gLastSeen_RBG;
  dword gLastSeen_TCU;
  dword gLastSeen_TPMS;
}

/*----------------------------------------------------------------------------
  Heartbeat.  One receiver for every frame: any frame from a node refreshes
  its timestamp, so the panel LED goes green while the node talks and red
  once it is killed with OFFLINE_<NODE> -- a real timeout viewer.
----------------------------------------------------------------------------*/
on message *
{
  dword now = timeNow();

  if (this.ABS) gLastSeen_ABS = now;
  if (this.DIAG) gLastSeen_DIAG = now;
  if (this.EMS) gLastSeen_EMS = now;
  if (this.EPS) gLastSeen_EPS = now;
  if (this.HVAC) gLastSeen_HVAC = now;
  if (this.ICN) gLastSeen_ICN = now;
  if (this.ICU) gLastSeen_ICU = now;
  if (this.ITPMS) gLastSeen_ITPMS = now;
  if (this.MMS) gLastSeen_MMS = now;
  if (this.PEPS) gLastSeen_PEPS = now;
  if (this.RBG) gLastSeen_RBG = now;
  if (this.TCU) gLastSeen_TCU = now;
  if (this.TPMS) gLastSeen_TPMS = now;
}

on start
{
  setTimerCyclic(tmrTesterBridge, 100);
  write("[TesterBridge] active, namespace NBCM_Test");
}

/*----------------------------------------------------------------------------
  One tick: either publish restbus values to the system variables
  (DRIVE_MODE=0) or push tester values into the restbus (DRIVE_MODE=1).
----------------------------------------------------------------------------*/
on timer tmrTesterBridge
{
  long i;
  long driveMode = @sysvar::NBCM_Test::DRIVE_MODE;

  // node offline switches always come from the tester
  OFFLINE_ABS = @sysvar::NBCM_Test::OFFLINE_ABS;
  OFFLINE_DIAG = @sysvar::NBCM_Test::OFFLINE_DIAG;
  OFFLINE_EMS = @sysvar::NBCM_Test::OFFLINE_EMS;
  OFFLINE_EPS = @sysvar::NBCM_Test::OFFLINE_EPS;
  OFFLINE_HVAC = @sysvar::NBCM_Test::OFFLINE_HVAC;
  OFFLINE_ICN = @sysvar::NBCM_Test::OFFLINE_ICN;
  OFFLINE_ICU = @sysvar::NBCM_Test::OFFLINE_ICU;
  OFFLINE_ITPMS = @sysvar::NBCM_Test::OFFLINE_ITPMS;
  OFFLINE_MMS = @sysvar::NBCM_Test::OFFLINE_MMS;
  OFFLINE_PEPS = @sysvar::NBCM_Test::OFFLINE_PEPS;
  OFFLINE_RBG = @sysvar::NBCM_Test::OFFLINE_RBG;
  OFFLINE_TCU = @sysvar::NBCM_Test::OFFLINE_TCU;
  OFFLINE_TPMS = @sysvar::NBCM_Test::OFFLINE_TPMS;

  if (driveMode != gLastDriveMode)
  {
    write("[TesterBridge] DRIVE_MODE = %d", driveMode);
    gLastDriveMode = driveMode;
  }

  // scenario controls are always visible to both sides
  SCENARIO_RUNNING = @sysvar::NBCM_Test::SCENARIO_RUNNING;
  MANUAL_SPEED_MODE = @sysvar::NBCM_Test::MANUAL_SPEED_MODE;
  MANUAL_SPEED_KMH = @sysvar::NBCM_Test::MANUAL_SPEED_KMH;

  if (driveMode == 1)
  {
    // tester owns the signals
    Hs_Abs_Active = @sysvar::NBCM_Test::Hs_Abs_Active;
    Hs_Abs_DiagMode = @sysvar::NBCM_Test::Hs_Abs_DiagMode;
    Hs_Abs_Ebd_Active = @sysvar::NBCM_Test::Hs_Abs_Ebd_Active;
    Hs_Abs_Ebd_Error = @sysvar::NBCM_Test::Hs_Abs_Ebd_Error;
    Hs_Abs_Ebd_Warning = @sysvar::NBCM_Test::Hs_Abs_Ebd_Warning;
    Hs_Abs_Error = @sysvar::NBCM_Test::Hs_Abs_Error;
    Hs_Abs_Esp_Enable = @sysvar::NBCM_Test::Hs_Abs_Esp_Enable;
