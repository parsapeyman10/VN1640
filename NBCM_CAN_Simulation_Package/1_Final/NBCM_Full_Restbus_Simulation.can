  msTimer tmr10, tmr20, tmr100, tmr200, tmr500, tmr1000, tmr5000, tmrEvent, tmrScenario;
}

on start
{
  setTimerCyclic(tmrScenario, 10);
  setTimerCyclic(tmr10, 10);
  setTimerCyclic(tmr20, 20);
  setTimerCyclic(tmr100, 100);
  setTimerCyclic(tmr200, 200);
  setTimerCyclic(tmr500, 500);
  setTimerCyclic(tmr1000, 1000);
  setTimerCyclic(tmr5000, 5000);
  setTimerCyclic(tmrEvent, 1000);
  write("=== شبیه‌سازی کامل شبکه (Full Restbus) شروع شد - %d پیام از %d گره ===",
        98, 13);
}

/*============================================================================
  موتور سناریوی رانندگی - فقط سیگنال‌های SCENARIO_DRIVEN را آپدیت می‌کند
============================================================================*/
on timer tmrScenario
{
  double dtSec = 0.01;
  double speed;

  if (MANUAL_SPEED_MODE)
  {
    speed = MANUAL_SPEED_KMH;
  }
  else if (SCENARIO_RUNNING)
  {
    gPhaseTimeMs += 10;
    switch (gPhase)
    {
      case 0:
        speed = 0;
        Hs_Ems_Rpm = 800;
        if (gPhaseTimeMs >= T_IDLE_MS) { gPhase = 1; gPhaseTimeMs = 0; }
        break;
      case 1:
        speed = Hs_Abs_VehicleSpeed + ACCEL_RATE;
        if (speed >= SPEED_URBAN) { speed = SPEED_URBAN; gPhase = 2; gPhaseTimeMs = 0; }
        Hs_Ems_Rpm = 800 + (1800 - 800) * (speed / SPEED_URBAN);
        break;
      case 2:
        speed = SPEED_URBAN; Hs_Ems_Rpm = 1800;
        if (gPhaseTimeMs >= T_URBAN_MS) { gPhase = 3; gPhaseTimeMs = 0; }
        break;
      case 3:
        speed = Hs_Abs_VehicleSpeed + ACCEL_RATE;
        if (speed >= SPEED_HIGHWAY) { speed = SPEED_HIGHWAY; gPhase = 4; gPhaseTimeMs = 0; }
        Hs_Ems_Rpm = 1800 + (2600 - 1800) * ((speed - SPEED_URBAN) / (SPEED_HIGHWAY - SPEED_URBAN));
        break;
      case 4:
        speed = SPEED_HIGHWAY; Hs_Ems_Rpm = 2600;
        if (gPhaseTimeMs >= T_HIGHWAY_MS) { gPhase = 5; gPhaseTimeMs = 0; }
        break;
      case 5:
        speed = Hs_Abs_VehicleSpeed - DECEL_RATE;
        if (speed <= 0) { speed = 0; gPhase = 0; gPhaseTimeMs = 0; }
        Hs_Ems_Rpm = 800 + (2600 - 800) * (speed / SPEED_HIGHWAY);
        break;
    }
  }
  else
  {
    speed = Hs_Abs_VehicleSpeed;  // توقف سناریو - آخرین مقدار نگه داشته می‌شود
  }

  Hs_Abs_VehicleSpeed = speed;
  Hs_Abs_VehicleSpeed_Invalid = Hs_Abs_VehicleSpeed_Invalid; // دست‌نخورده - از پنل قابل تزریق خطا
  LS_ICN_SPD_GWY = speed;

  gOdometerKm += speed * (dtSec / 3600.0);
  Hs_Ems_Distance = Hs_Ems_Distance + speed * (dtSec / 3600.0) * 1000.0; // متر
  LS_ICN_ODO = gOdometerKm * 1000.0;                                      // متر
  Ls_Icn_Mileage = gOdometerKm;                                           // کیلومتر
}

