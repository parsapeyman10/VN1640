/*============================================================================
  تایمرها - هر گروه، پیام‌های هم‌دوره را با Cycle Time واقعی DBC ارسال می‌کند
============================================================================*/
on timer tmr10
{
  Send_HS_ID_SAS();
  Send_HS_ID_TCU_INFO_3();
  Send_HS_ID_TCU_INFO_2();
  Send_HS_ID_EMS11();
  Send_HS_ID_EMS10();
  Send_HS_ID_EMS9();
  Send_HS_ID_EMS1();
  Send_HS_ID_ABS_BRAKE();
  Send_HS_ID_TCU_INFO1();
  Send_HS_ID_EMS7();
  Send_HS_ID_EMS6();
  Send_HS_ID_EMS2();
}

on timer tmr20
{
  Send_HS_ID_ABS_INFO2();
  Send_HS_ID_EMS8();
  Send_HS_ID_ABS();
}

on timer tmr100
{
  Send_HS_ID_ITPMS_INFO();
  Send_HS_ID_PEPS_1();
  Send_HS_ID_ESP_1();
  Send_HS_ID_ESC_ITPMS();
  Send_HS_ID_TPMS_INFO();
  Send_HS_ID_EPS1();
  Send_LS_ID_INFO_HVAC();
  Send_LS_ID_TARA__ETAT_COMBINE();
}

on timer tmr200
{
  Send_HS_ID_ICU_INFO();
  Send_HS_ID_ABS_PULSE();
  Send_LS_ID_TARA_ICU_INFO();
  Send_LS_ID_TARA_INFO_RBG();
}

on timer tmr500
{
  Send_LS_ID_ICNI2_IC();
}

on timer tmr1000
{
  Send_HS_ID_ICU_SUP();
  Send_HS_ID_TPMS_SUP();
  Send_HS_ID_EPS_SUP();
  Send_HS_ID_TCU_SUP();
  Send_HS_ID_EMS_SUP();
  Send_HS_ID_ABS_ESP_SUP();
  Send_LS_ID_SUP_MMS();
  Send_LS_ID_ICNI1_IC();
  Send_LS_ID_SUP_HVAC();
  Send_LS_ID_DEBUG_IC();
  Send_LS_ID_TARA_CMB_CFG_VOY();
  Send_LS_ID_TARA_SUPERVISION_MMS();
  Send_LS_ID_TARA_SUPERVISION_CMB();
  Send_LS_ID_TARA_SUPERVISION_RBG();
  Send_LS_ID_TIME_MMS();
  Send_LS_ID_SUP_IC();
}

on timer tmr5000
{
  Send_HS_ID_EMS_T_AMB();
}

on timer tmrEvent  // پیام‌های Event-based در DBC - این‌جا هر 1s برای پوشش تست
{
  Send_HS_ID_ICU_RESET_REQ();
  Send_HS_ID_IMM_LearnSKReq();
  Send_HS_ID_IMM_TeachPINReq();
  Send_HS_ID_IMM_TeachSKReq();
  Send_HS_ID_IMM_AUTH();
  Send_HS_ID_EMS_RESET_RESP();
  Send_HS_ID_EMS_TeachSKResp();
  Send_HS_ID_EMS_LearnPINResp();
  Send_HS_ID_EMS_LearnSKResp();
  Send_HS_ID_EMS_CHALL();
  Send_HS_ID_ICU_DIAG_REQ();
  Send_HS_ID_ICU_DIAG_ANS();
  Send_HS_ID_ICU_E1();
  Send_HS_ID_TPMS_DIAG_REQ();
  Send_HS_ID_TPMS_DIAG_ANS();
  Send_HS_ID_EPS_DIAG_REQ();
  Send_HS_ID_EPS_DIAG_ANS();
  Send_HS_ID_TCU_DIAG_REQ();
  Send_HS_ID_TCU_DIAG_ANS();
  Send_HS_ID_EMS_DIAG_REQ();
  Send_HS_ID_EMS_DIAG_ANS();
  Send_HS_ID_EMS_ICU_1();
  Send_HS_ID_DIAG_REQ_BROADCAST();
  Send_HS_ID_DIAG_REQ_RBG();
  Send_HS_ID_DIAG_REQ_MMS();
  Send_HS_ID_DIAG_REQ_ICN();
  Send_HS_ID_DIAG_REQ_NBCM();
  Send_LS_ID_FR_HVAC();
  Send_LS_ID_DIAG_RESP_HVAC();
  Send_LS_ID_DIAG_RESP_MMS();
  Send_LS_ID_TARA_CRH_RBG();
  Send_LS_ID_TARA_VERSION_MMS();
  Send_LS_ID_TARA_REP_DIAG_MMS();
  Send_LS_ID_TARA_EVT_DEFAUT_MMS();
  Send_LS_ID_TARA_ECRAN_INFO_PROFILS();
  Send_LS_ID_TARA_DMD_MAJ_DATE_HEURE();
  Send_LS_ID_TARA_EVT_DEFAUT_RBG();
  Send_LS_ID_TARA_VERSION_CMB();
  Send_LS_ID_TARA_REP_DIAG_CMB();
  Send_LS_ID_TARA_KM_SAUV_CMB();
  Send_LS_ID_DENA_ICN_INFO1_IC();
  Send_LS_ID_DENA_MAINT_INFO_IC();
  Send_LS_ID_TARA__EVT_DEFAUT_CMB();
  Send_LS_ID_TARA_REP_DIAG_RBG();
  Send_LS_ID_TARA_VERSION_RBG();
  Send_LS_ID_DENA_BACKLIGHT_IC();
  Send_LS_ID_DENA_TIME_IC();
  Send_LS_ID_DIAG_RESP_IC();
  Send_LS_ID_DENA_ODO_IC();
  Send_LS_ID_DENA_DIAG_RESP_IC();
  Send_LS_ID_DENA_SUP_IC();
  Send_LS_ID_DENA_FR_IC();
  Send_LS_ID_FR_IC();
}